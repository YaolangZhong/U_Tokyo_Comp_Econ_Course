# UPLOADED when explicitly staged and committed:
# weeks/**/slides/tex/    TeX sources and their assets
# weeks/**/slides/pdf/    published PDF handouts
# weeks/**/lab/           notebooks, Python code, intentional teaching data
# Student-facing README files, topics/, figures/, bibliography/, scripts/, build config

# LOCAL ONLY: generated build output and archival duplicate build output
/build/
/archive/previous_builds/
/archive/local_cache/
# Use these directory names for disposable lab output or private local inputs.
**/results/
**/local/

# LOCAL ONLY: environments, Python/Jupyter caches, OS files, secrets
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store
.env
.env.*
!.env.example

# LOCAL ONLY: LaTeX intermediates (also excluded if a manual build leaves them beside TeX)
*.aux
*.log
*.out
*.nav
*.snm
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
*.bbl
*.blg
*.bcf
*.run.xml
*.vrb
*.xdv
*.tmp
# PDFs and TeX are NOT globally ignored: students need PDFs and editors need sources.

# Quarto website: built and deployed by GitHub Actions, not committed to main
/_site/
/.quarto/
/downloads/
/weeks/week_*/_materials.qmd
/_topic-materials.qmd

**/*.quarto_ipynb

# Instructor-only material: retained locally, excluded from the public repository
/docs/
/archive/
/Final_Project/
/.vscode/
/backend/
